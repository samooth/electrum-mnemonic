{
  "name": "@samooth/electrum-mnemonic",
  "version": "0.0.1",
  "description": "Electrum Mnemonics (electrum v2 and greater)",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && npm run formatjs",
    "clean": "rm -rf src",
    "coverage": "npm run unit -- --coverage",
    "format": "npm run prettier -- --write",
    "formatjs": "npm run prettierjs -- --write > /dev/null 2>&1",
    "format:ci": "npm run prettier -- --check",
    "gitdiff": "git diff --exit-code",
    "gitdiff:ci": "npm run build && npm run gitdiff",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "prepublishOnly": "npm run test && npm run gitdiff",
    "prettier": "prettier 'ts_src/**/*.ts' --ignore-path ./.prettierignore",
    "prettierjs": "prettier 'src/**/*.js' --ignore-path ./.prettierignore",
    "test": "npm run build && npm run format:ci && npm run lint && npm run unit",
    "unit": "jest --config=jest.json --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samooth/electrum-mnemonic.git"
  },
  "keywords": [
    "electrum",
    "mnemonic",
    "seed",
    "backup"
  ],
  "author": "Jonathan Underwood",
  "license": "MIT",
  "files": [
    "src"
  ],
  "contributors": [
    {
      "name": "Tomás Díaz",
      "email": "tomas@bsv.direct",
      "url": "https://github.com/samooth"
    }
  ],  
  "bugs": {
    "url": "https://github.com/samooth/electrum-mnemonic/issues"
  },
  "homepage": "https://github.com/samooth/electrum-mnemonic#readme",
  "devDependencies": {
    "@types/create-hmac": "^1.1.3",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.4",
    "@types/pbkdf2": "^3.1.2",
    "@types/randombytes": "^2.0.3",
    "bitcoinjs-lib": "6.1.5",
    "jest": "^29.7.0",
    "prettier": "^3.2.2",
    "ts-jest": "^29.1.1",
    "tslint": "^6.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "create-hmac": "^1.1.7",
    "pbkdf2": "^3.1.2",
    "randombytes": "^2.1.0"
  }
}
